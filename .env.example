# Anthropic Claude API
ANTHROPIC_API_KEY=your-key-here

# Brave Search API (used by Professor agents for content generation)
BRAVE_API_KEY=your-key-here

# Database
DB_SUPERUSER_PASSWORD=changeme
# Password for the `postgres` bootstrap superuser (cluster admin; never used by the application).
APP_DB_PASSWORD=changeme
# Password for the `valory_app` application role created on first boot by scripts/initdb/01-app-role.sh.
DATABASE_URL=postgres://valory_app:changeme@db:5432/valory?sslmode=disable
# Password segment must equal APP_DB_PASSWORD. Existing deployments must follow docs/runbooks/rls-role-hardening.md before switching.

# TLS — leave ACME_DOMAIN empty for development (self-signed cert is generated automatically)
ACME_DOMAIN=
ACME_CACHE_DIR=/app/acme-cache

# Operator-supplied TLS certificate pair (REQ-INFRA-003).
# Set both to enable BYO-cert mode (takes precedence over ACME_DOMAIN).
# Setting only one is a startup error. Leave both empty to use ACME or self-signed.
VALORY_TLS_CERT_FILE=
VALORY_TLS_KEY_FILE=

# Reverse-proxy mode (REQ-INFRA-006).
# Set to "true" when a TLS-terminating reverse proxy (e.g. nginx, Caddy, Traefik)
# sits in front of Valory. The app serves plain HTTP on :8443; the proxy handles TLS.
# Combining this with VALORY_TLS_CERT_FILE, VALORY_TLS_KEY_FILE, or ACME_DOMAIN
# is a startup error (REQ-INFRA-008).
VALORY_BEHIND_PROXY=

# Auth session configuration
AUTH_LOCKOUT_DURATION=15m
AUTH_SESSION_MAX_DURATION=24h
AUTH_INACTIVITY_PERIOD=30m

# Agent pipeline
AGENT_RETRY_LIMIT=3
CORRECTION_LOOP_MAX=5
CONTENT_GENERATION_TIMEOUT_SECONDS=300

# Storage
UPLOADS_DIR=/app/uploads

# Master key enabling the managed-secrets subsystem (admin-entered API keys,
# AES-256-GCM encrypted at rest). Generate once at install:
#   openssl rand -base64 32
# If unset, managed secrets are disabled and the server falls back to the
# ANTHROPIC_API_KEY / BRAVE_API_KEY environment variables.
VALORY_SECRET_KEY=
